[Unit]
Description=Send an input device to a remote host via input_transfer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/input-transfer-send
ExecStart=/usr/local/bin/input-transfer-send.sh
Restart=always
RestartSec=2

# Hardening (DeviceAllow can't reference the devices config file's
# contents, so device access is left open here; tighten with a static
# DeviceAllow= for your specific /dev/input/eventN if desired)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
