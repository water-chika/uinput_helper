# Environment for input-transfer-send.service
# Device to open and share (see /proc/bus/input/devices or `input_dump`
# with no args to find the right node).
INPUT_DEVICE=/dev/input/event3
# Host/IP of the machine running input-transfer-receive.service.
REMOTE_HOST=other-host.local
# Must match the port input-transfer-receive.service is listening on.
REMOTE_PORT=9111
