# Environment for input-transfer-send.service
# Device(s) to open and share, as repeated -d flags (see
# /proc/bus/input/devices or `input_dump` with no args to find the right
# node(s)). Left unquoted in the unit file so multiple -d args work.
INPUT_DEVICES="-d /dev/input/event3"
# Host/IP of the machine running input-transfer-receive.service.
REMOTE_HOST=other-host.local
# Must match the port input-transfer-receive.service is listening on.
REMOTE_PORT=9111
