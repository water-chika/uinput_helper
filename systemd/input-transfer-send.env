# Environment for input-transfer-send.service
# Path to the devices config file: one /dev/input/eventN node per line,
# '#' comments and blank lines ignored. See devices.conf.example.
DEVICES_FILE=/etc/input-transfer/devices.conf

# Set LISTEN=1 to wait for a peer to connect instead of connecting out
# (e.g. when the remote side is behind NAT / has no reachable port).
LISTEN=0

# Used when LISTEN=0: host/IP of the machine running
# input-transfer-receive.service.
REMOTE_HOST=other-host.local
# Must match the port input-transfer-receive.service is listening on.
REMOTE_PORT=9111

# Used when LISTEN=1: port to listen on (optional, defaults to
# input_transfer's built-in default port if unset).
#LISTEN_PORT=9111

# How much input_transfer logs: quiet, error, warn, info (default),
# debug or trace. Passed through to input_transfer as its
# $INPUT_TRANSFER_LOG_LEVEL fallback for --log-level. debug adds device
# capabilities and periodic event counters; trace logs every forwarded
# event and will flood the journal, so use it only while debugging.
#INPUT_TRANSFER_LOG_LEVEL=info
