# Environment for keyboard-joystick.service

# Keyboard whose keys become two virtual joysticks. Prefer a stable
# /dev/input/by-id/... path over /dev/input/eventN, which can change
# across reboots or re-plugs.
KEYBOARD_DEVICE=/dev/input/by-id/usb-YOUR_KEYBOARD-event-kbd

# GRAB=1 takes the keyboard exclusively (EVIOCGRAB): its keys drive only
# the joysticks and stop reaching this machine's desktop. GRAB=0 leaves
# it shared, so keys both play the game and type locally.
GRAB=1

# Optional key mapping file (see keyboard-joystick.conf.example and
# "keyboard_joystick --help"). Leave unset to use the built-in default
# mapping. Generate a starting point with:
#   keyboard_joystick --print-map > /etc/keyboard-joystick/map.conf
#MAP_FILE=/etc/keyboard-joystick/map.conf

# Set LISTEN=1 to wait for a peer to connect instead of connecting out.
LISTEN=0

# Used when LISTEN=0: host/IP running "input_transfer receive" for the
# joysticks. Use a port of its own if another input_transfer pair (e.g.
# a forwarded mouse) already uses the default 9111, so the two streams
# can be restarted independently.
REMOTE_HOST=other-host.local
REMOTE_PORT=9112

# Used when LISTEN=1: port to listen on.
#LISTEN_PORT=9112

# How much input_transfer logs: quiet, error, warn, info (default),
# debug or trace.
#INPUT_TRANSFER_LOG_LEVEL=info
